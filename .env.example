DB_ROOT_PASSWORD=admin123
DB_USER=bgsistemas
DB_PASSWORD=admin123
JWT_SECRET=change-me-use-a-long-random-string-of-at-least-64-characters
# BGSI-276: 32 random bytes in Base64 -> openssl rand -base64 32
TOTP_ENCRYPTION_KEY=
ADMIN_EMAIL=admin@bgsistemas.es
ADMIN_PASSWORD=change-me
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TO=

# BGSI-328: only for the "prod" profile (SPRING_PROFILES_ACTIVE=prod), see docs/supabase.md.
# In production DB_USER and DB_PASSWORD are the ones of Supabase
# DB_URL=jdbc:postgresql://aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
# DB_SCHEMA=app
# DDL_AUTO=validate
# CORS_ALLOWED_ORIGINS=https://your-website.com

# BGSI-327: images. local (default) = uploads folder; supabase = Supabase Storage, see docs/supabase.md
STORAGE_TYPE=local
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=images
